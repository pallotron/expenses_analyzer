# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Environments
.venv

# IDE / Editor specific
.idea/
.vscode/
*.swp

# OS specific
.DS_Store

# Test output
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
coverage.xml

# uv lock file
uv.lock

# Ignore all .csv files except those in the examples/ directory
*.csv
!examples/*.csv

# Local databases. A migrated expenses.db holds the full transaction history,
# so this must never become committable. WAL mode writes the -wal/-shm
# sidecars alongside it, which carry the same data.
*.db
*.db-shm
*.db-wal
*.sqlite*
